# ─── API Keys ───
# Regístrate en https://console.groq.com para obtener una key
GROQ_API_KEY=tu_groq_api_key

# Regístrate en https://platform.deepseek.com para obtener una key
DEEPSEEK_API_KEY=tu_deepseek_api_key

# Regístrate en https://developers.google.com/tenor para obtener una key
TENOR_API_KEY=tu_tenor_api_key

# Regístrate en https://api.you.com para obtener una key
YOU_API_KEY=tu_you_api_key

# OPCIONAL — Parallel Search MCP (https://search.parallel.ai/mcp)
# El addon chat usa el buscador Parallel SIN key (gratis con rate-limit bajo).
# Solo agrega una key de https://platform.parallel.ai si quieres límites más altos.
PARALLEL_API_KEY=

# ─── YouTube Cookies (para el addon ytdl) ───
# El addon ytdl.js acepta cookies en formato JSON (arreglo) o Netscape (texto).
# Se busca en: assets/www.youtube.com_cookies.json  (recomendado)
#              www.youtube.com_cookies.json
#              assets/www.youtube.com_cookies.txt
#              www.youtube.com_cookies.txt
#
# 📌 Cómo obtener las cookies de YouTube:
# 1. Instala la extensión "cookies_localy.txt" en tu navegador (Chrome/Firefox).
# 2. Ve a https://www.youtube.com y asegúrate de haber iniciado sesión.
# 3. Haz clic en la extensión y exporta las cookies.
# 4. La extensión exporta en formato Netscape (compatible con yt-dlp).
# 5. Guarda el archivo como:  assets/www.youtube.com_cookies.json
#    (aunque la extensión exporte .txt, el addon detecta el formato automáticamente)
#
# ⚠️ Si tienes las cookies en formato JSON de otra extensión,
#    el addon las convertirá automáticamente a Netscape al vuelo.
#
# 🦕 Requisito: Deno (JavaScript runtime para yt-dlp)
#    YouTube ahora exige resolver un "n-challenge" para obtener formatos de video.
#    yt-dlp necesita Deno instalado en el servidor para resolverlo.
#    Instalación:
#      curl -fsSL https://deno.land/install.sh | sh
#    Después de instalar, reiniciá el bot con !restart

# ─── Addons portados del bot de rupa ───

# The Cat API — fotos de gatos del addon cat (https://thecatapi.com)
CAT_API_KEY=tu_cat_api_key

# OCR.space — extracción de texto del addon ocr (https://ocr.space/ocrapi)
# La key "helloworld" sirve para pruebas limitadas.
OCR_SPACE_KEY=tu_ocr_space_key

# Canal/newsletter para channel.js (publicación automática de tasas + gráfica)
# y envfoto.js (envío manual de imágenes). Formato: 120363XXXXXXXX@newsletter
# Si queda vacío, la publicación automática se desactiva (.graf sigue funcionando).
NEWS_CHANNEL_ID=

# Números con privilegios de dueño (opcional) para los addons de moderación
# (ban, mute, add, pin, rm) y para speed/gif. Formato: 584123456789,182790133969133
OWNER_NUMBERS=

# Identidades extra del bot para chequeos de admin en grupos (opcional).
# Normalmente no hace falta: se detectan solas desde la sesión de Baileys.
BOT_NUMBERS=

# Servidor Minecraft por defecto del addon server (opcional)
MC_DEFAULT_SERVER=FocaTostada.aternos.me
