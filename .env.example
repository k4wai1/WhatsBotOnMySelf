# ─── API Keys ───
# Regístrate en https://console.groq.com para obtener una key
GROQ_API_KEY=tu_groq_api_key

# Regístrate en https://platform.deepseek.com para obtener una key
DEEPSEEK_API_KEY=tu_deepseek_api_key

# Regístrate en https://developers.google.com/tenor para obtener una key
TENOR_API_KEY=tu_tenor_api_key

# Regístrate en https://api.you.com para obtener una key
YOU_API_KEY=tu_you_api_key

# ─── YouTube Cookies (para el addon ytdl) ───
# El addon ytdl.js acepta cookies en formato JSON (arreglo) o Netscape (texto).
# Se busca en: assets/www.youtube.com_cookies.json  (recomendado)
#              www.youtube.com_cookies.json
#              assets/www.youtube.com_cookies.txt
#              www.youtube.com_cookies.txt
#
# 📌 Cómo obtener las cookies de YouTube:
# 1. Instala la extensión "cookies_localy.txt" en tu navegador (Chrome/Firefox).
# 2. Ve a https://www.youtube.com y asegúrate de haber iniciado sesión.
# 3. Haz clic en la extensión y exporta las cookies.
# 4. La extensión exporta en formato Netscape (compatible con yt-dlp).
# 5. Guarda el archivo como:  assets/www.youtube.com_cookies.json
#    (aunque la extensión exporte .txt, el addon detecta el formato automáticamente)
#
# ⚠️ Si tienes las cookies en formato JSON de otra extensión,
#    el addon las convertirá automáticamente a Netscape al vuelo.
